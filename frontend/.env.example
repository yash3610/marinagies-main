# Public frontend settings. Never put passwords or secrets in VITE_ variables.
VITE_API_URL=/api
# Leave empty to use the frontend origin (proxied locally).
# For a separate backend host, set its origin, e.g. https://api.example.com
VITE_SOCKET_URL=

# Backend target used by Vite dev/preview proxies; not exposed to browser code.
BACKEND_PROXY_URL=http://localhost:5000
