PORT=5000

MONGO_URI=

JWT_SECRET=replace-with-at-least-32-random-characters

FRONTEND_URL=http://localhost:5173

# Disabled by default so production never generates fake vessel movement.
ENABLE_TELEMETRY_SIMULATOR=false

# Device/edge agents send this in X-Telemetry-Key. Use at least 32 random characters.
TELEMETRY_INGESTION_KEY=

# GhostTrace combined anomaly score required before an alert is raised (0.50-0.95).
GHOSTTRACE_ALERT_THRESHOLD=0.70

# SARVerify trust thresholds. Above accept is forwarded; below reject is flagged as likely false.
SAR_AUTO_ACCEPT_THRESHOLD=0.75
SAR_AUTO_REJECT_THRESHOLD=0.40

# RecoveryShield AES-256 snapshot encryption key. Use at least 32 random characters.
RECOVERY_ENCRYPTION_KEY=

# Contact form email (Gmail example)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="MarineAegis Website <your-email@gmail.com>"
CONTACT_TO_EMAIL=your-email@gmail.com

# For a custom SMTP provider, remove SMTP_SERVICE and use:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
